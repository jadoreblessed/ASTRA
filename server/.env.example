# ASTRA backend. Every value has a safe default; with no .env at all the
# backend runs read-only on an embedded database (npm run dev:all).

NODE_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:3000

# Empty → embedded PGlite in ./.data/pg (single process: npm run dev:all).
# Set it to run api / worker / signer as separate processes (docker compose does).
DATABASE_URL=

SOLANA_CLUSTER=mainnet-beta
# Use a paid RPC for trading; the public one is fine for reading.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# npm run keys → paste both. MASTER_KEY seals every wallet key; lose it and the
# custodial wallets and the vault are gone, leak it and so is everything else.
MASTER_KEY=
SIGNER_TOKEN=
SIGNER_HOST=127.0.0.1
SIGNER_PORT=8081

# Login codes by email. Empty → codes are printed to the log (dev only).
RESEND_API_KEY=
MAIL_FROM=ASTRA <login@yourdomain.com>

# ---- money. All off / tiny by default. ----
TRADING_ENABLED=false
# Lifetime cap on what the platform itself spends (fees + rent), lamports. 0.05 SOL.
MAX_TOTAL_SPEND_LAMPORTS=50000000
MAX_ORDER_USD=5
MAX_SLIPPAGE_BPS=100
PRICE_MAX_AGE_SEC=120
